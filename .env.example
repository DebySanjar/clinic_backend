# ──────────────────────────────────────────────────────────────────
# DentFlow Backend — Environment Variables
# Bu faylni .env ga nusxalab, qiymatlarni to'ldiring
# cp .env.example .env
# ──────────────────────────────────────────────────────────────────

# Django (yangi kalit yaratish: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DEBUG=False

# PythonAnywhere username ingizni yozing (masalan: yourname.pythonanywhere.com)
ALLOWED_HOSTS=yourname.pythonanywhere.com,localhost,127.0.0.1

# Vercel deploy qilingandan keyin to'liq URL yozing
CORS_ALLOWED_ORIGINS=https://your-admin-panel.vercel.app,https://your-user-panel.vercel.app,http://localhost:5173,http://localhost:5174

# Telegram
TELEGRAM_BOT_TOKEN=8637757726:AAG3KoedgifzM-eCDjMndH3eWpcqaZdMWX0
# User panel Vercel URL (frontend/user_panel deploy qilingandan keyin)
WEBAPP_URL=https://your-user-panel.vercel.app
# PythonAnywhere domen (webhook uchun)
WEBHOOK_URL=https://yourname.pythonanywhere.com

# Klinika ma'lumotlari
CLINIC_NAME=DentFlow Klinikasi
CLINIC_ADDRESS=Toshkent sh., Chilonzor tumani
CLINIC_PHONE=+998901234567
